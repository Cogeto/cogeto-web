# Contact form relay (server side only; the browser never sees these).
# Copy to .env.local on the server and fill in the key, then restart pm2.
# Use a Mailgun DOMAIN SENDING KEY (Sending > Domain settings > Sending
# keys), not the account-wide private API key.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.cogeto.eu
# eu or us; picks the API endpoint. The cogeto.eu domain lives in the EU region.
MAILGUN_REGION=eu
CONTACT_TO=hi@cogeto.eu
CONTACT_FROM="Cogeto website <website@mg.cogeto.eu>"
